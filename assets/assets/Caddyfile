{
	admin 0.0.0.0:2019
}

(common) {
	import deny_bots
	import block_dotfiles
}

(php_site) {
	import common
	php_fastcgi php-fpm:9000
	file_server browse
}

(php_site_strict) {
	import php_site
	header {
		Cross-Origin-Embedder-Policy require-corp
		Cross-Origin-Opener-Policy same-origin
		Cache-Control "no-cache, no-store, must-revalidate"
	}
}

(auth) {
	basic_auth {
		webmaster $2a$14$IA2pZE6PMsvvAII5mZLiNeoswj9V6W1p51g/s4PNdNT1JDit9Z9Q6
	}
}

(deny_bots) {
	@robots path /robots.txt
	handle @robots {
		header Content-Type text/plain
		respond "User-agent: *
Disallow: /" 200
	}
}

(block_dotfiles) {
	@dotfiles path */.git/*
	respond @dotfiles 403
}

(duckdns_tls) {
	tls {
		dns duckdns {env.DUCKDNS_TOKEN}
	}
}

(porkbun_tls) {
	tls {
		dns porkbun {
			api_key {env.PORKBUN_API_KEY}
			api_secret_key {env.PORKBUN_API_SECRET}
		}
	}
}

(cloudflare_tls) {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
}

